@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG)

# odelia ships as an R package and has no CMake package of its own, so the
# include directory cannot be found automatically. Ask for it here rather than
# letting the failure surface later as a missing <odelia/interpolator.hpp> from
# inside leaf's own headers, which points nowhere near the cause.
if(NOT DEFINED LEAF_ODELIA_INCLUDE_DIR OR NOT EXISTS "${LEAF_ODELIA_INCLUDE_DIR}/odelia/interpolator.hpp")
  set(leaf_FOUND FALSE)
  set(leaf_NOT_FOUND_MESSAGE
      "leaf needs odelia's headers. Clone https://github.com/traitecoevo/odelia "
      "and configure with -DLEAF_ODELIA_INCLUDE_DIR=/path/to/odelia/inst/include")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/leafTargets.cmake")

target_include_directories(leaf::leaf SYSTEM INTERFACE "${LEAF_ODELIA_INCLUDE_DIR}")

check_required_components(leaf)
